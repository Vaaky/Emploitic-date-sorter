{
  "manifest_version": 3,
  "name": "Emploitic – Tri par date de publication",
  "version": "1.4.0",
  "description": "Ajoute un tri par date de publication (page actuelle ou toutes les pages) à la liste des offres d'emploi d'Emploitic, avec les logos d'entreprise.",
  "permissions": ["storage"],
  "browser_specific_settings": {
    "gecko": {
      "id": "emploitic-date-sort@vaak.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://emploitic.com/*",
        "https://www.emploitic.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
